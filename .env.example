# Copy this file to .env and fill in your values

# LLM provider for answer generation
LLM_PROVIDER=anthropic             # "anthropic" (prod) | "gemini" (free dev tier)

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Gemini (used when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# Embeddings — choose one provider and set its key
# Option A: OpenAI text-embedding-3-small (default)
OPENAI_API_KEY=sk-...
EMBEDDING_PROVIDER=openai          # "openai" | "voyage"
EMBEDDING_MODEL=text-embedding-3-small

# Option B: Voyage AI voyage-3
# VOYAGE_API_KEY=pa-...
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-3

# Postgres — REQUIRED
DATABASE_URL=postgresql://grc:grc_secret@localhost:5432/grc_db

# Auth — REQUIRED. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# CORS — set to your real frontend domain in production
ALLOWED_ORIGINS=https://sentinel.yourdomain.com

# HSTS — set to true once your domain has HTTPS live
HTTPS_ONLY=true

# S3 file storage — set all four to move XLSX files out of Postgres
# Supports AWS S3, Cloudflare R2, or any S3-compatible provider
# Leave blank to store files in Postgres (local dev only)
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=auto
S3_ENDPOINT_URL=https://xxxx.r2.cloudflarestorage.com  # blank for AWS

# Claude model
CLAUDE_MODEL=claude-sonnet-4-5

# Tests — pytest sets this via tests/conftest.py; do not enable in production
# TESTING=true
