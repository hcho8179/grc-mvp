# Copy this file to .env and fill in your values

# LLM provider for answer generation
LLM_PROVIDER=anthropic             # "anthropic" (prod) | "gemini" (free dev tier)

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Gemini (used when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# Embeddings — choose one provider and set its key
# Option A: OpenAI text-embedding-3-small (default)
OPENAI_API_KEY=sk-...
EMBEDDING_PROVIDER=openai          # "openai" | "voyage"
EMBEDDING_MODEL=text-embedding-3-small

# Option B: Voyage AI voyage-3
# VOYAGE_API_KEY=pa-...
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-3

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgresql://grc:grc_secret@localhost:5432/grc_db

# Claude model
CLAUDE_MODEL=claude-sonnet-4-5
